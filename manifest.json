{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "version": "0.0.2",
  "name": "tabsaver",
  "description": "Salve e organize suas abas em coleções, libere memória do navegador e retome de onde parou.",
  "icons": {
    "48": "images/extension_48.png"
  },
  "permissions": ["tabs", "storage"],
  "action": {
    "default_title": "Abrir TabSaver"
  },
  "background": {
    "service_worker": "src/background.ts"
  },
  "chrome_url_overrides": {
    "newtab": "src/index.html"
  },
  "author": "Your Name"
}
