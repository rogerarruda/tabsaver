{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "version": "0.0.2",
  "name": "tabsaver",
  "description": "Salve e organize suas abas em coleções, libere memória do navegador e retome de onde parou.",
  "icons": {
    "16": "images/tabsaver-16.png",
    "32": "images/tabsaver-32.png",
    "48": "images/tabsaver-48.png",
    "128": "images/tabsaver-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "favicon",
    "contextMenus"
  ],
  "action": {
    "default_title": "Abrir TabSaver",
    "default_icon": {
      "16": "images/tabsaver-16.png",
      "32": "images/tabsaver-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.ts"
  },
  "chrome_url_overrides": {
    "newtab": "src/index.html"
  },
  "author": "Your Name"
}
