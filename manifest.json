{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "version": "0.0.2",
  "name": "tabsaver",
  "description": "Salve e organize suas abas em cole\u00e7\u00f5es, libere mem\u00f3ria do navegador e retome de onde parou.",
  "icons": {
    "16": "images/tabsaver-16.png",
    "32": "images/tabsaver-32.png",
    "48": "images/tabsaver-48.png",
    "128": "images/tabsaver-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "favicon",
    "contextMenus",
    "tabGroups"
  ],
  "action": {
    "default_title": "Abrir TabSaver",
    "default_icon": {
      "16": "images/tabsaver-16.png",
      "32": "images/tabsaver-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.ts"
  },
  "chrome_url_overrides": {
    "newtab": "src/index.html"
  },
  "author": "Your Name",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      }
    },
    "quick-save-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Salvar as abas da janela em uma nova cole\u00e7\u00e3o, com confirma\u00e7\u00e3o antes de fechar"
    }
  }
}
